{
  "name": "monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "docker-compose up -d && turbo dev db:studio",
    "build": "turbo build",
    "preview": "turbo preview",
    "db:migrate": "yarn workspace server db:migrate",
    "db:reset": "yarn workspace server db:reset",
    "db:studio": "yarn workspace server db:studio",
    "db:seed": "yarn workspace server db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "repomix": "^1.13.1",
    "turbo": "^2.9.6"
  },
  "packageManager": "yarn@4.13.0"
}
