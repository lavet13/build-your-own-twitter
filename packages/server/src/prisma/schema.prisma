// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/prisma"
}

generator pothos {
  provider          = "prisma-pothos-types"
  clientOutput      = "./prisma" // relative path from pothos output to prisma client
  output            = "../lib/pothos-prisma-types.ts"
  generateDatamodel = "true"
}

datasource db {
  provider = "postgresql"
}

/// Permission is just a named capability. The name follows a pattern you defined:
/// category:action:scope (e.g. message:delete:any, user:edit:own). Nothing more
/// it's a record that says "this capability exists."
model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // category:action:scope, e.g. "message:delete:any"
  description String?

  isActive  Boolean  @default(true) // can disable without deleting
  createdAt DateTime @default(now())

  users UserPermission[] // direct grants to users
  roles RolePermission[] // grants to roles

  @@index([name])
  @@index([isActive])
}

/// Role is a named group of permissions. A user belongs to exactly one role
model Role {
  id          String  @id @default(cuid())
  name        String  @unique // "ADMIN", "MODERATOR", "USER"
  description String?

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
}

/// This is a join table between Role and Permission. Nothing fancy.
model RolePermission {
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum PermissionStatus {
  ACTIVE
  REVOKED
  PENDING
}

/// This is the hybrid part. The grantedById field is doing double duty:
///
/// If it has a value → this permission was explicitly granted directly to this user by an admin
/// If it's null → this permission is explicitly revoked from this user
model UserPermission {
  userId String
  user   User   @relation("UserPermissions", fields: [userId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  status PermissionStatus @default(ACTIVE)
  // ACTIVE = granted, REVOKED = revoked, PENDING = future use

  grantedAt   DateTime @default(now())
  grantedById String? // who granted/revoked it — now purely audit info
  grantedBy   User?    @relation("GrantedPermissions", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([grantedById])
}

enum AuthProviderType {
  EMAIL
  PHONE
  TELEGRAM
}

model TelegramVerification {
  id String @id @default(cuid())

  // The code shown to the user on the website
  // Short, human-readable: "A4X-K9P"
  code String @unique

  // Null until the user sends the code to the bot
  // Once the bot receives it, we store which Telegram user sent it
  telegramId String?

  // Whether the website has consumed this verification
  // (exchanged it for a session)
  confirmed Boolean @default(false)

  // Short TTL - codes expire in 5 minutes
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([code])
  @@index([expiresAt]) // for cleanup queries
}

model AuthProvider {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type AuthProviderType

  // What this field means per type:
  // EMAIL    → normalized email address (lowercase)
  // PHONE    → E.164 format phone number (+79001234567)
  // TELEGRAM → Telegram user ID as string ("123456789")
  //
  // Uniqueness is enforced per type — same email can't register twice,
  // but the same string could theoretically be both an email and a phone
  // (which can't happen in practice, but the constraint is explicit)
  identifier String

  // Argon2 hash for EMAIL and PHONE providers.
  // Always null for TELEGRAM — the bot interaction is the credential.
  credential String?

  // Metadata — useful for display and debugging
  // For TELEGRAM: we can store first_name, username from the bot message
  // For EMAIL/PHONE: null
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One account per (type, identifier) pair globally
  @@unique([type, identifier])
  @@index([userId])
  @@index([type, identifier]) // fast lookup during login
}

model User {
  id          String  @id @default(cuid())
  username    String? @unique
  displayName String?

  // Denormalized email for convenience — kept in sync with EMAIL AuthProvider.
  // Nullable because Telegram-only users have no email.
  // Used for display and as a human-readable identifier in admin tools.
  email String? @unique

  // User belongs to one role(Role-based access control)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Direct permissions (user-specific overrides)
  directPermissions  UserPermission[] @relation("UserPermissions")
  permissionsGranted UserPermission[] @relation("GrantedPermissions")

  authProviders       AuthProvider[]
  refreshTokenVersion Int            @default(1)
  sessions            Session[]

  // Social
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  profile          Profile?
  followedBy       Follow[]  @relation("followedBy") // Users who follow me
  following        Follow[]  @relation("following") // Users I follow

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([username])
  @@index([email])
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String @unique
  tokenVersion Int // Matches user.refreshTokenVersion when created

  deviceName String?
  deviceId   String?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
}

model Follow {
  followedBy   User   @relation("followedBy", fields: [followedById], references: [id], onDelete: Cascade)
  followedById String

  followingId String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followingId, followedById]) // Can't follow same person twice
  @@index([followedById])
}

model Profile {
  id        String   @id @default(cuid())
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id      String @id @default(cuid())
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Restrict)

  replyToId String? // nullable — null means it's a top-level message
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull) // Parent message
  replies   Message[] @relation("MessageReplies") // Child messages

  isRead Boolean   @default(false)
  readAt DateTime?

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
}
